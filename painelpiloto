<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Painel Master — Pilha de Estéril ECHEMAT</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Oswald:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#ffffff;
    --surface:#f3f9f5;
    --surface-2:#eaf3ec;
    --border:#d7e8dd;
    --border-strong:#b9d9c5;
    --green:#0b8a3e;
    --green-dark:#065c29;
    --green-bright:#1fb356;
    --text:#12241a;
    --text-muted:#5c7d6c;
    --red:#c62828;
    --amber:#b5790f;
    --ink-dark:#0a1310;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html,body{height:100%;overflow:hidden;}
  body{background:var(--bg);color:var(--text);font-family:'Inter',sans-serif;}
  .mono{font-family:'JetBrains Mono',monospace;}
  .disp{font-family:'Space Grotesk',sans-serif;}
  .news{font-family:'Oswald',sans-serif;}

  .app{height:100vh;width:100vw;display:grid;grid-template-rows:auto 1fr auto;padding:1.6vh 2vw;gap:1.1vh;}

  header{display:flex;align-items:center;justify-content:space-between;padding-bottom:1.1vh;border-bottom:1.5px solid var(--border-strong);min-height:0;}
  .brand{display:flex;align-items:center;gap:1vw;}
  .mark{width:clamp(30px,4.2vh,46px);height:clamp(30px,4.2vh,46px);flex:none;}
  .brand h1{font-family:'Space Grotesk',sans-serif;font-size:clamp(15px,2.5vh,26px);font-weight:700;color:var(--green-dark);letter-spacing:0.2px;}
  .brand p{font-size:clamp(9px,1.15vh,13px);color:var(--text-muted);letter-spacing:1.4px;text-transform:uppercase;margin-top:2px;font-weight:500;}
  .head-right{display:flex;align-items:center;gap:1.6vw;}
  .status-pill{display:flex;align-items:center;gap:7px;padding:0.5vh 1vw;background:rgba(11,138,62,0.08);border:1px solid rgba(11,138,62,0.30);border-radius:20px;font-size:clamp(9px,1.1vh,12px);letter-spacing:1px;text-transform:uppercase;font-weight:600;color:var(--green);}
  .dot{width:7px;height:7px;border-radius:50%;background:var(--green-bright);box-shadow:0 0 6px var(--green-bright);animation:pulse 1.8s infinite;}
  @keyframes pulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:0.4;transform:scale(0.7);}}
  .clock{text-align:right;}
  .clock .time{font-size:clamp(14px,2.1vh,22px);font-weight:600;letter-spacing:0.5px;color:var(--text);}
  .clock .date{font-size:clamp(9px,1.05vh,12px);color:var(--text-muted);letter-spacing:0.5px;}

  .stage{position:relative;min-height:0;}
  .slide{position:absolute;inset:0;opacity:0;pointer-events:none;transition:opacity .7s ease;display:flex;flex-direction:column;min-height:0;}
  .slide.active{opacity:1;pointer-events:auto;}

  .card{background:var(--surface);border:1px solid var(--border);border-radius:14px;min-height:0;}

  /* SLIDE 1 — visão geral */
  #slide1{gap:1.4vh;}
  .kpi-row{display:grid;grid-template-columns:repeat(5,1fr);gap:1vw;flex:none;height:19vh;}
  .kpi{padding:1.6vh 1.3vw;display:flex;flex-direction:column;justify-content:center;position:relative;}
  .kpi::before{content:'';position:absolute;top:0;left:14px;right:14px;height:2px;background:var(--green-bright);border-radius:0 0 2px 2px;}
  .kpi-label{font-size:clamp(9px,1.05vh,12px);color:var(--text-muted);font-weight:600;letter-spacing:0.3px;text-transform:uppercase;}
  .kpi-val{font-family:'JetBrains Mono',monospace;font-size:clamp(18px,3.3vh,32px);font-weight:700;margin-top:0.8vh;color:var(--text);line-height:1;}
  .kpi-val .unit{font-size:clamp(10px,1.3vh,14px);color:var(--text-muted);font-weight:500;margin-left:3px;}
  .kpi-sub{font-size:clamp(9px,1vh,12px);margin-top:0.8vh;font-weight:600;}
  .kpi-sub.neg{color:var(--red);}
  .kpi-sub.pos{color:var(--green);}
  .chart-card{flex:1;min-height:0;padding:1.6vh 1.6vw;display:flex;flex-direction:column;}
  .panel-title{display:flex;align-items:baseline;justify-content:space-between;flex:none;margin-bottom:0.6vh;}
  .panel-title h2{font-family:'Space Grotesk',sans-serif;font-size:clamp(13px,1.8vh,19px);font-weight:600;color:var(--green-dark);}
  .panel-title .note{font-size:clamp(9px,1vh,12px);color:var(--text-muted);}
  .legend{display:flex;gap:1.2vw;font-size:clamp(9px,1.05vh,12px);color:var(--text);flex:none;margin-bottom:0.4vh;}
  .legend span{display:flex;align-items:center;gap:5px;font-weight:500;}
  .sw{width:9px;height:9px;border-radius:2px;}
  .chart-wrap{position:relative;flex:1;min-height:0;}

  /* SLIDE 2 — pilha 3D */
  #slide2{flex-direction:row;gap:1.4vw;}
  .pile-stats-col{width:24vw;flex:none;display:flex;flex-direction:column;gap:1.1vh;}
  .stat-card{padding:1.6vh 1.4vw;}
  .stat-card .kpi-label{margin-bottom:0.6vh;}
  .stat-card .big{font-family:'JetBrains Mono',monospace;font-size:clamp(22px,4.6vh,44px);font-weight:700;color:var(--green-dark);line-height:1;}
  .stat-card .small{font-size:clamp(10px,1.15vh,13px);color:var(--text-muted);margin-top:0.7vh;}
  .cone-card{flex:1;min-height:0;position:relative;overflow:hidden;display:flex;flex-direction:column;padding:1.4vh 1.4vw;}
  .cone-canvas-wrap{position:relative;flex:1;min-height:0;}
  #coneCanvas{position:absolute;inset:0;width:100%;height:100%;display:block;}
  .tick-label{position:absolute;font-family:'JetBrains Mono',monospace;font-size:clamp(9px,1.05vh,12px);color:var(--text-muted);font-weight:600;transform:translate(4px,-50%);white-space:nowrap;pointer-events:none;}
  .tick-dash{position:absolute;height:1px;background:var(--border-strong);width:14px;transform:translateY(-50%);pointer-events:none;}
  .current-badge{position:absolute;transform:translate(10px,-50%);background:var(--green);color:#fff;font-family:'JetBrains Mono',monospace;font-weight:700;font-size:clamp(10px,1.2vh,14px);padding:5px 10px;border-radius:8px;white-space:nowrap;pointer-events:none;box-shadow:0 2px 8px rgba(11,138,62,0.35);}
  .cone-legend{display:flex;gap:1.4vw;flex:none;justify-content:center;font-size:clamp(9px,1.05vh,12px);color:var(--text-muted);font-weight:500;margin-top:0.4vh;}
  .cone-legend span{display:flex;align-items:center;gap:5px;}
  .sw-round{width:9px;height:9px;border-radius:50%;}

  /* SLIDE 3 — meta diaria */
  #slide3{gap:1.4vh;}
  .daily-row{display:flex;gap:1.2vw;flex:none;height:40vh;}
  .daily-block{flex:1;padding:1.8vh 1.7vw;display:flex;flex-direction:column;}
  .daily-block-title{font-family:'Space Grotesk',sans-serif;font-size:clamp(12px,1.5vh,17px);font-weight:600;color:var(--green-dark);padding-bottom:1vh;margin-bottom:1.2vh;border-bottom:1.5px solid var(--border-strong);}
  .daily-pair{display:flex;gap:1vw;flex:1;}
  .daily-item{flex:1;background:var(--surface-2);border-radius:10px;padding:1.4vh 1.2vw;display:flex;flex-direction:column;justify-content:center;}
  .daily-item .lbl{font-size:clamp(9px,1.05vh,12px);color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:0.4px;}
  .daily-item .val{font-family:'JetBrains Mono',monospace;font-size:clamp(20px,4vh,38px);font-weight:700;margin-top:0.7vh;line-height:1;}
  .daily-item .val .u{font-size:0.4em;color:var(--text-muted);font-weight:500;margin-left:2px;}
  .daily-block-pct{margin-top:1.1vh;font-family:'JetBrains Mono',monospace;font-weight:700;font-size:clamp(15px,2.2vh,22px);text-align:right;}
  .daily-comment{flex:1;min-height:0;background:var(--ink-dark);border-radius:14px;padding:2.2vh 2.4vw;display:flex;flex-direction:column;justify-content:center;gap:0.8vh;}
  .daily-comment .eyebrow{font-family:'Space Grotesk',sans-serif;font-size:clamp(10px,1.2vh,14px);letter-spacing:2px;text-transform:uppercase;color:#4ade80;font-weight:600;}
  .daily-comment p{font-family:'Oswald',sans-serif;font-size:clamp(16px,2.6vh,26px);font-weight:400;color:#eaf6ee;line-height:1.4;letter-spacing:0.2px;}
  .daily-comment p b{font-weight:600;color:#8fe3b0;}

  /* SLIDES 4-6 — comentarios individuais estilo noticia */
  .comment-slide{flex:1;min-height:0;display:flex;flex-direction:column;justify-content:center;gap:2.2vh;padding:0 1vw;}
  .comment-eyebrow{font-family:'Space Grotesk',sans-serif;font-size:clamp(11px,1.4vh,16px);letter-spacing:3px;text-transform:uppercase;color:var(--green);font-weight:700;display:flex;align-items:center;gap:12px;}
  .comment-eyebrow::before{content:'';width:34px;height:4px;background:var(--green-bright);border-radius:2px;}
  .comment-headline{font-family:'Oswald',sans-serif;font-weight:700;font-size:clamp(30px,6.6vh,64px);line-height:1.06;letter-spacing:0.2px;color:var(--ink-dark);max-width:92%;}
  .comment-headline.warn{color:var(--amber);}
  .comment-headline.neg{color:var(--red);}
  .comment-headline.ok{color:var(--green-dark);}
  .comment-body{font-family:'Oswald',sans-serif;font-weight:400;font-size:clamp(16px,2.8vh,28px);line-height:1.5;color:var(--text);max-width:78%;}
  .comment-body b{font-weight:600;color:var(--green-dark);}
  .comment-body b.neg{color:var(--red);}
  .comment-meta{font-size:clamp(9px,1.05vh,12px);color:var(--text-muted);font-weight:500;letter-spacing:0.4px;}
  .comment-bar{position:absolute;left:0;top:14%;bottom:14%;width:6px;background:var(--green-bright);border-radius:0 3px 3px 0;}

  footer{display:flex;align-items:center;justify-content:space-between;gap:1.4vw;padding-top:1vh;border-top:1px solid var(--border);flex:none;min-height:0;}
  .foot-note{font-size:clamp(9px,1vh,12px);color:var(--text-muted);}
  .dots{display:flex;gap:8px;align-items:center;}
  .dot-i{width:7px;height:7px;border-radius:50%;background:var(--border-strong);transition:background .3s;}
  .dot-i.active{background:var(--green);}
  .progress-track{width:16vw;height:3px;background:var(--surface-2);border-radius:2px;overflow:hidden;}
  .progress-bar{height:100%;width:0%;background:var(--green-bright);border-radius:2px;}
  @keyframes slideProgress{from{width:0%;}to{width:100%;}}
</style>
</head>
<body>
<div class="app">

  <header>
    <div class="brand">
      <svg class="mark" viewBox="0 0 44 44" fill="none">
        <rect x="1" y="1" width="42" height="42" rx="9" stroke="#0b8a3e" stroke-width="1.5" fill="rgba(11,138,62,0.06)"/>
        <path d="M9 32 L16 20 L21 26 L27 14 L35 32 Z" fill="#0b8a3e" opacity="0.85"/>
        <path d="M9 32 L16 20 L21 26 L27 14 L35 32" stroke="#065c29" stroke-width="1.4" stroke-linejoin="round" fill="none"/>
      </svg>
      <div>
        <h1>Painel Master &mdash; Pilha de Estéril ECHEMAT</h1>
        <p>Cruzamento Plano &times; Realizado &middot; Piloto de apresentação</p>
      </div>
    </div>
    <div class="head-right">
      <div class="status-pill"><span class="dot"></span>Sistema ativo</div>
      <div class="clock">
        <div class="time mono" id="clockTime">--:--:--</div>
        <div class="date mono" id="clockDate">--/--/----</div>
      </div>
    </div>
  </header>

  <div class="stage">

    <div class="slide active" id="slide1">
      <div class="kpi-row">
        <div class="card kpi">
          <div class="kpi-label">% atingido do plano</div>
          <div class="kpi-val">65,2<span class="unit">%</span></div>
          <div class="kpi-sub neg">jul/26 &middot; mês vigente</div>
        </div>
        <div class="card kpi">
          <div class="kpi-label">Massa total realizada</div>
          <div class="kpi-val">1.348.692<span class="unit">t</span></div>
          <div class="kpi-sub pos">01/01 a 29/07/26</div>
        </div>
        <div class="card kpi">
          <div class="kpi-label">Volume planejado</div>
          <div class="kpi-val">120.054<span class="unit">m³</span></div>
          <div class="kpi-sub pos">plano vigente jul/26</div>
        </div>
        <div class="card kpi">
          <div class="kpi-label">Volume realizado</div>
          <div class="kpi-val">78.329<span class="unit">m³</span></div>
          <div class="kpi-sub neg">&#8595; 34,8% abaixo do plano</div>
        </div>
        <div class="card kpi">
          <div class="kpi-label">Variação</div>
          <div class="kpi-val" style="color:var(--red);">&minus;41.725<span class="unit">m³</span></div>
          <div class="kpi-sub neg">déficit no mês</div>
        </div>
      </div>
      <div class="card chart-card">
        <div class="panel-title">
          <h2>Plano &times; Realizado mensal (m&sup3;)</h2>
          <span class="note">Plano formal vigente a partir de jul/26</span>
        </div>
        <div class="legend">
          <span><span class="sw" style="background:#0b8a3e;"></span>Realizado</span>
          <span><span class="sw" style="background:#8fe3b0;"></span>Plano</span>
        </div>
        <div class="chart-wrap"><canvas id="planoChart"></canvas></div>
      </div>
    </div>

    <div class="slide" id="slide2">
      <div class="pile-stats-col">
        <div class="card stat-card">
          <div class="kpi-label">Nível atual real</div>
          <div class="big">9<span style="font-size:0.4em;color:var(--text-muted);"> / 20</span></div>
          <div class="small">Cota de estéril em preenchimento</div>
        </div>
        <div class="card stat-card">
          <div class="kpi-label">Preenchido no nível</div>
          <div class="big">89,3%</div>
          <div class="small">Faltam ~24.183 m³ p/ nível 10</div>
        </div>
        <div class="card stat-card">
          <div class="kpi-label">Capacidade total usada</div>
          <div class="big">10,3%</div>
          <div class="small">481.676 m³ de 4,69 Mi m³ projetados</div>
        </div>
      </div>
      <div class="card cone-card">
        <div class="panel-title"><h2>Ocupação por nível &mdash; corte 3D (níveis 7 a 20)</h2></div>
        <div class="cone-canvas-wrap">
          <canvas id="coneCanvas"></canvas>
          <div id="labelLayer"></div>
        </div>
        <div class="cone-legend">
          <span><span class="sw-round" style="background:#1a9c4c;"></span>Estéril preenchido</span>
          <span><span class="sw-round" style="background:#f5e6bd;border:1px solid #d1ab5c;"></span>Vazio / a preencher</span>
        </div>
      </div>
    </div>

    <div class="slide" id="slide3">
      <div class="daily-row">
        <div class="card daily-block">
          <div class="daily-block-title">Dia anterior &middot; 28/07/2026</div>
          <div class="daily-pair">
            <div class="daily-item">
              <div class="lbl">Plano do dia</div>
              <div class="val">3.873<span class="u"> m³</span></div>
            </div>
            <div class="daily-item">
              <div class="lbl">Realizado do dia</div>
              <div class="val" style="color:var(--red);">1.932<span class="u"> m³</span></div>
            </div>
          </div>
          <div class="daily-block-pct" style="color:var(--red);">49,9% da meta do dia</div>
        </div>
        <div class="card daily-block">
          <div class="daily-block-title">Mês de julho &middot; até o momento</div>
          <div class="daily-pair">
            <div class="daily-item">
              <div class="lbl">Plano do mês</div>
              <div class="val">120.054<span class="u"> m³</span></div>
            </div>
            <div class="daily-item">
              <div class="lbl">Realizado até o momento</div>
              <div class="val" style="color:var(--red);">78.329<span class="u"> m³</span></div>
            </div>
          </div>
          <div class="daily-block-pct" style="color:var(--red);">65,2% da meta do mês</div>
        </div>
      </div>
      <div class="daily-comment">
        <div class="eyebrow">Leitura diária &middot; IA</div>
        <p>Ontem (28/07) o ritmo diário ficou em <b>49,9%</b> da meta, puxando o mês para <b>65,2%</b> do plano até o momento. Se o ritmo dos últimos dias se mantiver, o déficit mensal se aprofunda além dos <b>41.725 m³</b> já registrados em julho.</p>
      </div>
    </div>

    <div class="slide comment-slide" id="slide4">
      <div class="comment-bar"></div>
      <div class="comment-eyebrow">Análise mensal &middot; IA</div>
      <div class="comment-headline warn">Julho fecha em 65,2% da meta</div>
      <div class="comment-body">78.329 m&sup3; realizados contra <b>120.054 m&sup3;</b> planejados &mdash; déficit de <b class="neg">41.725 m&sup3;</b> no primeiro mês em que o plano formal passou a vigorar.</div>
      <div class="comment-meta">Gerado por IA &middot; 29/07/2026 15:00</div>
    </div>

    <div class="slide comment-slide" id="slide5">
      <div class="comment-bar"></div>
      <div class="comment-eyebrow">Posição da pilha &middot; IA</div>
      <div class="comment-headline ok">Frente de estéril no nível 9</div>
      <div class="comment-body"><b>89,3%</b> do nível já preenchido &mdash; restam cerca de <b>24.183 m&sup3;</b> para avançar ao nível 10. A pilha usa hoje apenas <b>10,3%</b> da capacidade total projetada de 4,69 milhões de m&sup3;.</div>
      <div class="comment-meta">Gerado por IA &middot; 29/07/2026 15:00</div>
    </div>

    <div class="slide comment-slide" id="slide6">
      <div class="comment-bar"></div>
      <div class="comment-eyebrow">Recomendação operacional &middot; IA</div>
      <div class="comment-headline neg">Ritmo abaixo do necessário</div>
      <div class="comment-body">Junho e julho fecharam abaixo da meta mensal. Recomenda-se <b>reforço pontual de frota ou turno</b> na primeira semana de agosto para recuperar o atraso antes do próximo fechamento.</div>
      <div class="comment-meta">Gerado por IA &middot; 29/07/2026 15:00</div>
    </div>

  </div>

  <footer>
    <span class="foot-note">Fonte: BD Massa (89.160 registros) &middot; Densidade estéril 2,8 t/m&sup3;</span>
    <div class="dots" id="dots"></div>
    <div class="progress-track"><div class="progress-bar" id="progressBar"></div></div>
    <span class="foot-note">Próxima etapa: atualização automática via OneDrive</span>
  </footer>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
  function updateClock(){
    const now = new Date();
    document.getElementById('clockTime').textContent = now.toLocaleTimeString('pt-BR');
    document.getElementById('clockDate').textContent = now.toLocaleDateString('pt-BR', {weekday:'short', day:'2-digit', month:'2-digit', year:'numeric'});
  }
  updateClock();
  setInterval(updateClock, 1000);

  const ctx = document.getElementById('planoChart');
  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago'],
      datasets: [
        { label:'Realizado (m³)', data:[46800.11,12574.90,53904.24,90395.34,130597.61,69074.44,78329.29,0], backgroundColor:'#0b8a3e', borderRadius:3, maxBarThickness:44 },
        { label:'Plano (m³)', data:[null,null,null,null,null,null,120054.42,120054.42], backgroundColor:'#8fe3b0', borderRadius:3, maxBarThickness:44 }
      ]
    },
    options: {
      responsive:true, maintainAspectRatio:false,
      plugins:{
        legend:{display:false},
        tooltip:{callbacks:{label:(item)=> item.dataset.label+': '+(item.raw??0).toLocaleString('pt-BR',{maximumFractionDigits:0})+' m³'}}
      },
      scales:{
        x:{ grid:{display:false}, ticks:{ color:'#5c7d6c', font:{family:"'JetBrains Mono', monospace", size:12} } },
        y:{ grid:{color:'#eaf3ec'}, ticks:{ color:'#5c7d6c', font:{family:"'JetBrains Mono', monospace", size:11}, callback:(v)=>(v/1000).toFixed(0)+'k' } }
      }
    }
  });

  const niveis = [
    {n:7,  cap:63294.4,   fill:100},
    {n:8,  cap:215830.16, fill:100},
    {n:9,  cap:226734.32, fill:89.3, cur:true},
    {n:10, cap:309249.2,  fill:0},
    {n:11, cap:348394.24, fill:0},
    {n:12, cap:380809.2,  fill:0},
    {n:13, cap:403299.28, fill:0},
    {n:14, cap:428926.96, fill:0},
    {n:15, cap:444499.84, fill:0},
    {n:16, cap:470668.56, fill:0},
    {n:17, cap:491854.16, fill:0},
    {n:18, cap:398817.28, fill:0},
    {n:19, cap:300900.96, fill:0},
    {n:20, cap:207589.84, fill:0},
  ];

  let scene, camera, renderer, coneGroup, currentRing, currentSprite;
  const H = 130, rBase = 78, rTop = 22, GAP = 0.86;
  const sqrtCaps = niveis.map(l=>Math.sqrt(l.cap));
  const sqrtSum = sqrtCaps.reduce((a,b)=>a+b,0);
  const heights = sqrtCaps.map(s=>H*s/sqrtSum);

  function radiusAt(frac){ const rx = rBase + (rTop-rBase)*frac; return rx; }

  function makeLabelSprite(text){
    const cnv = document.createElement('canvas');
    cnv.width = 512; cnv.height = 160;
    const c = cnv.getContext('2d');
    c.clearRect(0,0,512,160);
    const pad = 22;
    c.font = '600 54px JetBrains Mono, monospace';
    const tw = c.measureText(text).width;
    const boxW = tw + pad*2, boxH = 96;
    const bx = 16, by = (160-boxH)/2;
    c.fillStyle = 'rgba(11,138,62,0.96)';
    roundRect(c, bx, by, boxW, boxH, 20);
    c.fill();
    c.fillStyle = '#ffffff';
    c.textBaseline = 'middle';
    c.fillText(text, bx+pad, by+boxH/2+4);
    const tex = new THREE.CanvasTexture(cnv);
    tex.minFilter = THREE.LinearFilter;
    const mat = new THREE.SpriteMaterial({map:tex, transparent:true, depthTest:false});
    const spr = new THREE.Sprite(mat);
    const scale = 0.34;
    spr.scale.set(boxW*scale*0.5, boxH*scale*0.5, 1);
    spr.center.set(0, 0.5);
    return spr;
  }
  function roundRect(c,x,y,w,h,r){
    c.beginPath();
    c.moveTo(x+r,y); c.arcTo(x+w,y,x+w,y+h,r); c.arcTo(x+w,y+h,x,y+h,r);
    c.arcTo(x,y+h,x,y,r); c.arcTo(x,y,x+w,y,r); c.closePath();
  }

  function initCone(){
    const wrap = document.querySelector('.cone-canvas-wrap');
    const canvas = document.getElementById('coneCanvas');
    const w = wrap.clientWidth, h = wrap.clientHeight;
    scene = new THREE.Scene();
    camera = new THREE.PerspectiveCamera(40, w/h, 0.1, 1000);
    camera.position.set(0, 44, 218);
    camera.lookAt(0, -6, 0);
    renderer = new THREE.WebGLRenderer({canvas:canvas, antialias:true, alpha:true});
    renderer.setPixelRatio(Math.min(window.devicePixelRatio,2));
    renderer.setSize(w, h);

    scene.add(new THREE.AmbientLight(0xffffff, 0.62));
    const key = new THREE.DirectionalLight(0xffffff, 0.72);
    key.position.set(90,150,110);
    scene.add(key);
    const fill = new THREE.DirectionalLight(0xdcefe2, 0.32);
    fill.position.set(-110,40,60);
    scene.add(fill);
    const rim = new THREE.DirectionalLight(0xbfe8d0, 0.55);
    rim.position.set(-40,60,-140);
    scene.add(rim);

    const shadowTex = new THREE.CanvasTexture(makeShadowCanvas());
    const shadowMat = new THREE.MeshBasicMaterial({map:shadowTex, transparent:true, depthWrite:false});
    const shadowMesh = new THREE.Mesh(new THREE.PlaneGeometry(220,220), shadowMat);
    shadowMesh.rotation.x = -Math.PI/2;
    shadowMesh.position.y = -H/2 - 4;
    scene.add(shadowMesh);

    coneGroup = new THREE.Group();
    coneGroup.rotation.x = -0.05;
    scene.add(coneGroup);

    let cumH = 0;
    niveis.forEach((lv,i)=>{
      const fracBottom = cumH/H;
      const hRaw = heights[i];
      cumH += hRaw;
      const fracTop = cumH/H;
      const rB = radiusAt(fracBottom);
      const rT = radiusAt(fracTop);
      const hBand = hRaw*GAP;
      const yCenter = -H/2 + (cumH - hRaw/2);
      const shade = i%2===0 ? 0xf5e6bd : 0xecd48f;

      if (lv.fill>0 && lv.fill<100){
        const splitFrac = lv.fill/100;
        const rSplit = radiusAt(fracBottom + (fracTop-fracBottom)*splitFrac);
        const hFilled = hBand*splitFrac, hEmpty = hBand*(1-splitFrac);
        const geoF = new THREE.CylinderGeometry(rSplit, rB, hFilled, 56, 1, false);
        const matF = new THREE.MeshStandardMaterial({color:0x1a9c4c, roughness:0.42, metalness:0.12});
        const meshF = new THREE.Mesh(geoF, matF);
        meshF.position.y = yCenter - hBand/2 + hFilled/2;
        coneGroup.add(meshF);
        addEdges(geoF, meshF.position.y, 0x0b5c2e, 0.5);

        const geoE = new THREE.CylinderGeometry(rT, rSplit, hEmpty, 56, 1, false);
        const matE = new THREE.MeshStandardMaterial({color:shade, roughness:0.85});
        const meshE = new THREE.Mesh(geoE, matE);
        meshE.position.y = yCenter + hBand/2 - hEmpty/2;
        coneGroup.add(meshE);
        addEdges(geoE, meshE.position.y, 0xb8934a, 0.55);

        const ringGeo = new THREE.TorusGeometry(rSplit, 1.3, 10, 64);
        currentRing = new THREE.Mesh(ringGeo, new THREE.MeshStandardMaterial({color:0x4ade80, emissive:0x1fb356, emissiveIntensity:0.7, roughness:0.3}));
        currentRing.rotation.x = Math.PI/2;
        currentRing.position.y = meshF.position.y + hFilled/2;
        coneGroup.add(currentRing);

        currentSprite = makeLabelSprite(`NÍVEL ${lv.n} · ${lv.fill}%`);
        currentSprite.position.set(rSplit+2, currentRing.position.y+10, 0);
        coneGroup.add(currentSprite);
      } else {
        const geo = new THREE.CylinderGeometry(rT, rB, hBand, 56, 1, false);
        const mat = lv.fill>=100
          ? new THREE.MeshStandardMaterial({color:0x1a9c4c, roughness:0.42, metalness:0.12})
          : new THREE.MeshStandardMaterial({color:shade, roughness:0.85});
        const mesh = new THREE.Mesh(geo, mat);
        mesh.position.y = yCenter;
        coneGroup.add(mesh);
        addEdges(geo, yCenter, lv.fill>=100?0x0b5c2e:0xb8934a, lv.fill>=100?0.5:0.55);
      }
    });

    animate();
  }

  function makeShadowCanvas(){
    const cnv = document.createElement('canvas');
    cnv.width = 256; cnv.height = 256;
    const c = cnv.getContext('2d');
    const g = c.createRadialGradient(128,128,10,128,128,120);
    g.addColorStop(0,'rgba(6,60,30,0.28)');
    g.addColorStop(1,'rgba(6,60,30,0)');
    c.fillStyle = g;
    c.fillRect(0,0,256,256);
    return cnv;
  }

  function addEdges(geo, yPos, color, opacity){
    const edges = new THREE.EdgesGeometry(geo, 25);
    const line = new THREE.LineSegments(edges, new THREE.LineBasicMaterial({color:color, transparent:true, opacity:opacity}));
    line.position.y = yPos;
    coneGroup.add(line);
  }

  let t0 = null;
  function animate(ts){
    requestAnimationFrame(animate);
    if(!t0) t0 = ts||0;
    const dt = (ts||0) - t0;
    if(coneGroup){
      coneGroup.rotation.y += 0.0022;
      coneGroup.position.y = Math.sin(dt*0.0006)*1.6;
    }
    if(currentRing){
      const pulse = 1 + Math.sin(dt*0.003)*0.06;
      currentRing.scale.set(pulse,1,pulse);
      currentRing.material.emissiveIntensity = 0.55 + Math.sin(dt*0.003)*0.25;
    }
    if(renderer) renderer.render(scene, camera);
  }

  function resizeCone(){
    const wrap = document.querySelector('.cone-canvas-wrap');
    if(!wrap || !renderer) return;
    const w = wrap.clientWidth, h = wrap.clientHeight;
    if(w<10||h<10) return;
    camera.aspect = w/h; camera.updateProjectionMatrix();
    renderer.setSize(w,h);
  }
  window.addEventListener('resize', resizeCone);
  window.addEventListener('load', ()=>{ initCone(); setTimeout(resizeCone,200); });

  const slides = [...document.querySelectorAll('.slide')];
  const dotsWrap = document.getElementById('dots');
  slides.forEach((_,i)=>{
    const d = document.createElement('div');
    d.className = 'dot-i'+(i===0?' active':'');
    dotsWrap.appendChild(d);
  });
  const dotEls = [...dotsWrap.children];
  const progressBar = document.getElementById('progressBar');
  const DURATION = 13000;
  let idx = 0;
  function showSlide(i){
    slides.forEach((s,j)=> s.classList.toggle('active', j===i));
    dotEls.forEach((d,j)=> d.classList.toggle('active', j===i));
    progressBar.style.animation = 'none';
    void progressBar.offsetWidth;
    progressBar.style.animation = `slideProgress ${DURATION}ms linear forwards`;
    if(i===1) setTimeout(resizeCone,80);
  }
  showSlide(0);
  setInterval(()=>{ idx=(idx+1)%slides.length; showSlide(idx); }, DURATION);
</script>
</body>
</html>
